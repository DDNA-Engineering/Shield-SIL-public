From c33925b81e63daeb3e3df9cf55040f9fe28f1ba9 Mon Sep 17 00:00:00 2001
From: SquadronConsult <michael@defense-dna.com>
Date: Tue, 10 Nov 2026 04:32:36 +0000
Subject: [PATCH 2/5] hw/arm/fsl-imx8mp: map GPC, SRC and a boot ROM with the
 ROM API

The boot ROM holds the ROM API table at 0x980 that U-Boot uses to ask for
the boot device, answered from the new boot-device property.
---
 hw/arm/fsl-imx8mp.c         | 100 ++++++++++++++++++++++++++++++++++++
 include/hw/arm/fsl-imx8mp.h |   6 +++
 2 files changed, 106 insertions(+)

diff --git a/hw/arm/fsl-imx8mp.c b/hw/arm/fsl-imx8mp.c
index ee6f3e4..09015f5 100644
--- a/hw/arm/fsl-imx8mp.c
+++ b/hw/arm/fsl-imx8mp.c
@@ -211,6 +211,10 @@ static void fsl_imx8mp_init(Object *obj)
 
     object_initialize_child(obj, "snvs", &s->snvs, TYPE_IMX7_SNVS);
 
+    object_initialize_child(obj, "gpc", &s->gpc, TYPE_IMX8MP_GPC);
+
+    object_initialize_child(obj, "src", &s->src, TYPE_IMX8MP_SRC);
+
     for (i = 0; i < FSL_IMX8MP_NUM_UARTS; i++) {
         g_autofree char *name = g_strdup_printf("uart%d", i + 1);
         object_initialize_child(obj, name, &s->uart[i], TYPE_IMX_SERIAL);
@@ -260,6 +264,79 @@ static void fsl_imx8mp_init(Object *obj)
                             TYPE_FSL_IMX8M_PCIE_PHY);
 }
 
+/*
+ * Boot ROM. Boot loaders call into the ROM through a table of function
+ * pointers at 0x980 (struct rom_api in U-Boot) to ask how the SoC booted.
+ * QEMU starts the boot loader itself, so the ROM here holds only that table
+ * and a small AArch64 routine that answers the queries: boot device (the
+ * "boot-device" property), ROM version, page size and boot stage. Image
+ * download requests fail (0xF1), because there is no ROM loader.
+ */
+#define BOOT_ROM_API_TABLE  0x980
+#define BOOT_ROM_API_CODE   0x1000
+
+static const uint32_t boot_rom_api_code[] = {
+    0x7100081f, /* query_boot_infor: cmp  w0, #2 (QUERY_BT_DEV) */
+    0x54000120, /*                   b.eq bt_dev                */
+    0x7100041f, /*                   cmp  w0, #1 (QUERY_ROM_VER)*/
+    0x54000120, /*                   b.eq rom_ver               */
+    0x71000c1f, /*                   cmp  w0, #3 (QUERY_PAGE_SZ)*/
+    0x54000120, /*                   b.eq page_sz               */
+    0x7100141f, /*                   cmp  w0, #5 (QUERY_BT_STAGE)*/
+    0x54000120, /*                   b.eq bt_stage              */
+    0xb900003f, /*                   str  wzr, [x1]             */
+    0x14000009, /*                   b    ok                    */
+    0x18000183, /* bt_dev:           ldr  w3, bootdev           */
+    0x14000006, /*                   b    store                 */
+    0x18000163, /* rom_ver:          ldr  w3, romver            */
+    0x14000004, /*                   b    store                 */
+    0x52804003, /* page_sz:          mov  w3, #512              */
+    0x14000002, /*                   b    store                 */
+    0x18000103, /* bt_stage:         ldr  w3, btstage           */
+    0xb9000023, /* store:            str  w3, [x1]              */
+    0x52801e00, /* ok:               mov  w0, #0xf0 (ROM_API_OKAY) */
+    0xd65f03c0, /*                   ret                        */
+    0x52801e20, /* download_image:   mov  w0, #0xf1             */
+    0xd65f03c0, /*                   ret                        */
+    0x00000000, /* bootdev:  set from the "boot-device" property */
+    0x00000010, /* romver                                        */
+    0x00000006, /* btstage:  primary boot                       */
+};
+#define BOOT_ROM_API_DOWNLOAD   (20 * 4)
+#define BOOT_ROM_API_BOOTDEV    (22 * 4)
+
+static bool fsl_imx8mp_boot_rom_init(FslImx8mpState *s, Error **errp)
+{
+    hwaddr size = fsl_imx8mp_memmap[FSL_IMX8MP_BOOT_ROM].size;
+    g_autofree uint8_t *rom = g_malloc0(size);
+    uint16_t ver = cpu_to_le16(1), tag = cpu_to_le16(0x22);
+    uint64_t download = cpu_to_le64(BOOT_ROM_API_CODE + BOOT_ROM_API_DOWNLOAD);
+    uint64_t query = cpu_to_le64(BOOT_ROM_API_CODE);
+    int i;
+
+    /* struct rom_api: u16 ver, u16 tag, u32 reserved, two function pointers */
+    memcpy(rom + BOOT_ROM_API_TABLE, &ver, 2);
+    memcpy(rom + BOOT_ROM_API_TABLE + 2, &tag, 2);
+    memcpy(rom + BOOT_ROM_API_TABLE + 8, &download, 8);
+    memcpy(rom + BOOT_ROM_API_TABLE + 16, &query, 8);
+    for (i = 0; i < ARRAY_SIZE(boot_rom_api_code); i++) {
+        uint32_t w = cpu_to_le32(boot_rom_api_code[i]);
+
+        memcpy(rom + BOOT_ROM_API_CODE + i * 4, &w, 4);
+    }
+    stl_le_p(rom + BOOT_ROM_API_CODE + BOOT_ROM_API_BOOTDEV, s->boot_device);
+
+    if (!memory_region_init_rom(&s->boot_rom, OBJECT(s), "imx8mp.boot_rom",
+                                size, errp)) {
+        return false;
+    }
+    memcpy(memory_region_get_ram_ptr(&s->boot_rom), rom, size);
+    memory_region_add_subregion(get_system_memory(),
+                                fsl_imx8mp_memmap[FSL_IMX8MP_BOOT_ROM].addr,
+                                &s->boot_rom);
+    return true;
+}
+
 static void fsl_imx8mp_realize(DeviceState *dev, Error **errp)
 {
     MachineState *ms = MACHINE(qdev_get_machine());
@@ -617,6 +694,19 @@ static void fsl_imx8mp_realize(DeviceState *dev, Error **errp)
     sysbus_connect_irq(SYS_BUS_DEVICE(&s->enet), 1,
                        qdev_get_gpio_in(gicdev, FSL_IMX6_ENET1_MAC_1588_IRQ));
 
+    /* GPC and SRC */
+    if (!sysbus_realize(SYS_BUS_DEVICE(&s->gpc), errp)) {
+        return;
+    }
+    sysbus_mmio_map(SYS_BUS_DEVICE(&s->gpc), 0,
+                    fsl_imx8mp_memmap[FSL_IMX8MP_GPC].addr);
+
+    if (!sysbus_realize(SYS_BUS_DEVICE(&s->src), errp)) {
+        return;
+    }
+    sysbus_mmio_map(SYS_BUS_DEVICE(&s->src), 0,
+                    fsl_imx8mp_memmap[FSL_IMX8MP_SRC].addr);
+
     /* SNVS */
     if (!sysbus_realize(SYS_BUS_DEVICE(&s->snvs), errp)) {
         return;
@@ -680,10 +770,18 @@ static void fsl_imx8mp_realize(DeviceState *dev, Error **errp)
                                 fsl_imx8mp_memmap[FSL_IMX8MP_OCRAM].addr,
                                 &s->ocram);
 
+    /* Boot ROM: the ROM API that boot loaders query for the boot device */
+    if (!fsl_imx8mp_boot_rom_init(s, errp)) {
+        return;
+    }
+
     /* Unimplemented devices */
     for (i = 0; i < ARRAY_SIZE(fsl_imx8mp_memmap); i++) {
         switch (i) {
         case FSL_IMX8MP_ANA_PLL:
+        case FSL_IMX8MP_BOOT_ROM:
+        case FSL_IMX8MP_GPC:
+        case FSL_IMX8MP_SRC:
         case FSL_IMX8MP_CCM:
         case FSL_IMX8MP_GIC_DIST:
         case FSL_IMX8MP_GIC_REDIST:
@@ -715,6 +813,8 @@ static void fsl_imx8mp_realize(DeviceState *dev, Error **errp)
 static const Property fsl_imx8mp_properties[] = {
     DEFINE_PROP_UINT32("fec1-phy-num", FslImx8mpState, phy_num, 0),
     DEFINE_PROP_BOOL("fec1-phy-connected", FslImx8mpState, phy_connected, true),
+    /* ROM API boot device: (type << 16) | (instance << 8); default SD2 */
+    DEFINE_PROP_UINT32("boot-device", FslImx8mpState, boot_device, 0x10100),
 };
 
 static void fsl_imx8mp_class_init(ObjectClass *oc, const void *data)
diff --git a/include/hw/arm/fsl-imx8mp.h b/include/hw/arm/fsl-imx8mp.h
index d016f7d..1bd79b0 100644
--- a/include/hw/arm/fsl-imx8mp.h
+++ b/include/hw/arm/fsl-imx8mp.h
@@ -17,6 +17,8 @@
 #include "hw/misc/imx7_snvs.h"
 #include "hw/misc/imx8mp_analog.h"
 #include "hw/misc/imx8mp_ccm.h"
+#include "hw/misc/imx8mp_gpc.h"
+#include "hw/misc/imx8mp_src.h"
 #include "hw/net/imx_fec.h"
 #include "hw/or-irq.h"
 #include "hw/pci-host/designware.h"
@@ -58,6 +60,8 @@ struct FslImx8mpState {
     IMXGPIOState       gpio[FSL_IMX8MP_NUM_GPIOS];
     IMX8MPCCMState     ccm;
     IMX8MPAnalogState  analog;
+    IMX8MPGPCState     gpc;
+    IMX8MPSRCState     src;
     IMX7SNVSState      snvs;
     IMXSPIState        spi[FSL_IMX8MP_NUM_ECSPIS];
     IMXI2CState        i2c[FSL_IMX8MP_NUM_I2CS];
@@ -70,8 +74,10 @@ struct FslImx8mpState {
     FslImx8mPciePhyState   pcie_phy;
     OrIRQState         gpt5_gpt6_irq;
     MemoryRegion       ocram;
+    MemoryRegion       boot_rom;
 
     uint32_t           phy_num;
+    uint32_t           boot_device;
     bool               phy_connected;
 };
 
