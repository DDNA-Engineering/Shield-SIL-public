# Shield SIL U-Boot: upstream qemu_arm64_defconfig plus these options.
# Boots the emulated eMMC (QEMU emmc on sdhci-pci) the way Shield's U-Boot does.
CONFIG_MMC=y
CONFIG_DM_MMC=y
CONFIG_MMC_PCI=y
CONFIG_MMC_SDHCI=y
CONFIG_MMC_HW_PARTITIONING=y
CONFIG_SUPPORT_EMMC_BOOT=y
CONFIG_CMD_MMC=y
CONFIG_CMD_GPT=y
CONFIG_CMD_PART=y
CONFIG_CMD_EXT4=y
CONFIG_CMD_FAT=y
CONFIG_CMD_FS_GENERIC=y
CONFIG_CMD_SETEXPR=y
# Environment as on Shield: one copy (not redundant) of 16 KiB at 0x3F0000 in the
# eMMC's second hardware boot partition (boot1), where the guest's fw_env.config
# points too.
# CONFIG_ENV_IS_IN_FLASH is not set
CONFIG_ENV_IS_IN_MMC=y
CONFIG_ENV_MMC_DEVICE_INDEX=0
CONFIG_ENV_MMC_EMMC_HW_PARTITION=2
CONFIG_ENV_OFFSET=0x3F0000
CONFIG_ENV_SIZE=0x4000
CONFIG_ENV_SOURCE_FILE="shield-sil"
CONFIG_BOOTDELAY=0
CONFIG_USE_BOOTCOMMAND=y
CONFIG_BOOTCOMMAND="run shield_boot"
# Host tools the image does not need (and that need extra libraries).
# CONFIG_TOOLS_MKEFICAPSULE is not set
