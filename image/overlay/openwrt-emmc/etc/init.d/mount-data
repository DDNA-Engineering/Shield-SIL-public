#!/bin/sh /etc/rc.common
# Shield SIL: the eMMC "data" partition (kept across updates) at /root/data.
# Found by its GPT name; given an ext4 file system on first use.

START=45

boot() {
	local u dev=""
	for u in /sys/class/block/*/uevent; do
		grep -qx 'PARTNAME=data' "$u" && dev=/dev/$(sed -n 's/^DEVNAME=//p' "$u") && break
	done
	[ -n "$dev" ] && [ -b "$dev" ] || return 0
	mkdir -p /root/data
	mountpoint -q /root/data && return 0
	mount -t ext4 -o rw,noatime "$dev" /root/data 2>/dev/null && return 0
	logger -t mount-data "no file system on $dev: making ext4"
	mkfs.ext4 -q -F -E nodiscard,lazy_itable_init=1,lazy_journal_init=1 -L data "$dev" && mount -t ext4 -o rw,noatime "$dev" /root/data
}
