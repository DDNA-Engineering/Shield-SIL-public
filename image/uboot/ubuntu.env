/* Shield SIL, Ubuntu: one slot. boot.scr, Image and the initrd are on p1 "boot"
 * (FAT), the root filesystem on p2 "rootfs". Appended to the machine's
 * environment (virt.env, or the imx8mp board's). */
shield_boot=
	echo "Shield: loading boot.scr from partition 1";
	load mmc ${shield_mmc}:1 ${scriptaddr} boot.scr && source ${scriptaddr}
