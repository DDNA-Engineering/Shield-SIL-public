diff --git a/arch/arm/dts/shield-sil-u-boot.dtsi b/arch/arm/dts/shield-sil-u-boot.dtsi
new file mode 100644
index 00000000..46e7ef21
--- /dev/null
+++ b/arch/arm/dts/shield-sil-u-boot.dtsi
@@ -0,0 +1,34 @@
+// SPDX-License-Identifier: GPL-2.0-or-later
+/*
+ * Shield SIL: U-Boot proper only (QEMU loads TF-A and U-Boot), so no binman
+ * image and no SPL nodes; just the devices U-Boot needs before relocation.
+ */
+
+/ {
+	binman: binman {
+	};
+
+	chosen {
+		stdout-path = &uart2;
+	};
+};
+
+&soc { bootph-all; };
+&clk {
+	bootph-all;
+	/delete-property/ assigned-clocks;
+	/delete-property/ assigned-clock-parents;
+	/delete-property/ assigned-clock-rates;
+};
+&osc_32k { bootph-all; };
+&osc_24m { bootph-all; };
+&aips1 { bootph-all; };
+&aips2 { bootph-all; };
+&aips3 {
+	bootph-all;
+	spba-bus@30800000 { bootph-all; };
+};
+&iomuxc { bootph-all; };
+&uart2 { bootph-all; };
+&usdhc3 { bootph-all; };
+&wdog1 { bootph-all; };
