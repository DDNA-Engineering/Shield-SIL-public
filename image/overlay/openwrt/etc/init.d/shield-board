#!/bin/sh /etc/rc.common
# Shield SIL front-panel LEDs and named GPIOs (uleds, gpio-sim).
# Before the LED and network configuration so their names exist when used.

START=11
USE_PROCD=1

start_service() {
	/usr/sbin/shield-board --needed || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/shield-board
	procd_set_param respawn 3600 2 0
	procd_set_param stderr 1
	procd_close_instance
}
