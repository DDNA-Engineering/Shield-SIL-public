diff --git a/include/configs/shield-sil.h b/include/configs/shield-sil.h
new file mode 100644
index 00000000..e85491f0
--- /dev/null
+++ b/include/configs/shield-sil.h
@@ -0,0 +1,22 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/*
+ * Shield SIL: emulated Shield on i.MX 8M Plus with 4 GiB of DRAM.
+ */
+
+#ifndef __SHIELD_SIL_H
+#define __SHIELD_SIL_H
+
+#include <linux/sizes.h>
+#include <asm/arch/imx-regs.h>
+
+#define CFG_SYS_INIT_RAM_ADDR	0x40000000
+#define CFG_SYS_INIT_RAM_SIZE	0x80000
+
+/* 4 GiB from 0x40000000: 3 GiB below the 4 GiB boundary, 1 GiB above it */
+#define CFG_SYS_SDRAM_BASE	0x40000000
+#define PHYS_SDRAM		0x40000000
+#define PHYS_SDRAM_SIZE		0xC0000000
+#define PHYS_SDRAM_2		0x100000000
+#define PHYS_SDRAM_2_SIZE	0x40000000
+
+#endif
