diff --git a/board/ddna/shield-sil/base.env b/board/ddna/shield-sil/base.env
new file mode 100644
index 00000000..f91e9268
--- /dev/null
+++ b/board/ddna/shield-sil/base.env
@@ -0,0 +1,10 @@
+/* Shield SIL (i.MX 8M Plus) board environment. image/uboot/build.sh appends
+ * the guest family's boot environment to it as shield-sil.env. */
+console=ttymxc1,115200
+fdt_addr_r=0x43000000
+kernel_addr_r=0x40480000
+ramdisk_addr_r=0x44000000
+scriptaddr=0x43f00000
+bootm_size=0x10000000
+fdtfile=shield-sil.dtb
+shield_mmc=2
diff --git a/board/ddna/shield-sil/shield-sil.c b/board/ddna/shield-sil/shield-sil.c
new file mode 100644
index 00000000..a38027f5
--- /dev/null
+++ b/board/ddna/shield-sil/shield-sil.c
@@ -0,0 +1,25 @@
+// SPDX-License-Identifier: GPL-2.0+
+/*
+ * Shield SIL: the Shield (i.MX 8M Plus, 4 GiB LPDDR4, eMMC on uSDHC3) as
+ * emulated by QEMU for software-in-the-loop testing. U-Boot proper only:
+ * QEMU loads TF-A and U-Boot, so there is no SPL and no DRAM training.
+ */
+
+#include <env.h>
+#include <asm/arch/sys_proto.h>
+
+#if CONFIG_IS_ENABLED(ENV_IS_IN_MMC)
+int board_mmc_get_env_dev(int devno)
+{
+	return CONFIG_ENV_MMC_DEVICE_INDEX;
+}
+#endif
+
+int board_late_init(void)
+{
+	if (IS_ENABLED(CONFIG_ENV_VARS_UBOOT_RUNTIME_CONFIG)) {
+		env_set("board_name", "Shield SIL");
+		env_set("board_rev", "iMX8MP");
+	}
+	return 0;
+}
