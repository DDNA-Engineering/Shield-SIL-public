#!/bin/sh /etc/rc.common
# Shield SIL hardware bus agent.

START=15
USE_PROCD=1

start_service() {
	procd_open_instance
	procd_set_param command /usr/sbin/shield-hwd
	# Test infrastructure, not software under test: keep up with the host even
	# while the guest is busy (e.g. mwan3 rebuilding its rules on a link change).
	procd_set_param nice -10
	procd_set_param respawn 3600 2 0
	procd_set_param stderr 1
	procd_close_instance
}
