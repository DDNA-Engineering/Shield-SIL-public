#!/bin/sh /etc/rc.common
# Shield SIL: USB-C usb0 as Shield's USB network gadget (network.usbc =
# "gadget"), exported to the SIL's simulated laptop over USB/IP. Before netifd
# (START=20), so usb0 exists when br-lan comes up. See /usr/sbin/shield-usb-gadget.

START=13
USE_PROCD=1

start_service() {
	[ -x /usr/sbin/shield-vudc-exportd ] || [ -x /usr/sbin/usbipd ] || return 0
	procd_open_instance
	procd_set_param command /usr/sbin/shield-usb-gadget
	procd_set_param respawn 3600 2 0
	procd_set_param stderr 1
	procd_close_instance
}
