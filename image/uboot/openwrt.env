/* Shield SIL, OpenWrt: boot slot A or B from the eMMC (mmc ${shield_mmc}),
 * appended to the machine's environment (virt.env, or the imx8mp board's).
 *
 * Slot A: boot partition p4, root p5 (distro_bootpart=4); slot B: p6, p7
 * (distro_bootpart=6). The slot's boot partition holds Image and boot.scr.
 * Switching slots is manual, as on Shield: fw_setenv distro_bootpart 6.
 */
distro_bootpart=4
shield_boot=
	echo "Shield: loading boot.scr from partition ${distro_bootpart}";
	load mmc ${shield_mmc}:${distro_bootpart} ${scriptaddr} boot.scr && source ${scriptaddr}
